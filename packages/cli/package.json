{
  "name": "@react-kino/cli",
  "version": "0.2.0",
  "description": "CLI for scaffolding react-kino scroll pages",
  "bin": {
    "kino": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "fs-extra": "^11",
    "kleur": "^4",
    "prompts": "^2",
    "@react-kino/core": "workspace:^",
    "react-kino": "workspace:^"
  },
  "devDependencies": {
    "@types/fs-extra": "^11",
    "@types/prompts": "^2",
    "tsup": "^8",
    "typescript": "^5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/btahir/react-kino.git",
    "directory": "packages/cli"
  },
  "homepage": "https://www.react-kino.dev/docs",
  "funding": {
    "type": "individual",
    "url": "https://react-tourlight.vercel.app/support"
  }
}
