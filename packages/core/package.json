{
  "name": "@react-kino/core",
  "version": "0.4.0",
  "description": "Framework-agnostic scroll engine powering react-kino",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./document": {
      "import": {
        "types": "./dist/document.d.mts",
        "default": "./dist/document.mjs"
      },
      "require": {
        "types": "./dist/document.d.ts",
        "default": "./dist/document.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^4"
  },
  "author": "Bilal Tahir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/btahir/react-kino.git",
    "directory": "packages/core"
  },
  "homepage": "https://www.react-kino.dev/docs",
  "bugs": {
    "url": "https://github.com/btahir/react-kino/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://react-tourlight.vercel.app/support"
  },
  "typesVersions": {
    "*": {
      "document": [
        "dist/document.d.ts"
      ]
    }
  }
}
